{
  "name": "gem-access",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "frontend:json-server": "json-server data/db.json --port 3000",
    "test": "node --test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node server/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "json-server": "^0.17.4",
    "prisma": "^7.10.1"
  },
  "overrides": {
    "effect": "3.22.1"
  }
}
