Vagrant.configure("2") do |config|
  config.vm.define "openvpn-lab" do |lab|
    lab.vm.box = "ubuntu/jammy64"
    lab.vm.hostname = "gem-openvpn-lab"
    lab.vm.synced_folder ".", "/vagrant", disabled: true

    lab.vm.network "private_network", ip: "192.168.56.10"
    lab.vm.provision "shell", path: "provision.sh"

    lab.vm.provider "virtualbox" do |virtualbox|
      virtualbox.memory = 1024
      virtualbox.cpus = 1
    end
  end
end
